# Copie este arquivo para 'worker/.env' e preencha com suas credenciais reais.
# O arquivo '.env' é ignorado pelo Git para evitar vazamento de segredos.

# Configurações do InfluxDB (v3 / Cloud Serverless na AWS)
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_TOKEN=seu_token_influxdb_aqui
INFLUX_DB=iot_telemetry_pipeline

# Configurações do Broker MQTT (HiveMQ Cloud com TLS)
# Utilize ssl:// ou tls:// para conexão criptografada na porta 8883
MQTT_URL=ssl://seu_cluster_id.s1.eu.hivemq.cloud:8883
MQTT_USER=seu_usuario_aqui
MQTT_PASSWORD=sua_senha_aqui

# Configurações Opcionais de Operação (Descomente para customizar)
# MQTT_CLIENT_ID=go_telemetry_worker_local
# MQTT_TOPIC=telemetry/temperature
# LOG_FORMAT=json  # Opções: 'text' ou 'json'
# LOG_LEVEL=INFO    # Opções: 'DEBUG', 'INFO', 'WARN', 'ERROR'
